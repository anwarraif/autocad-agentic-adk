# ---------------------------------------------------------------
# ADK x AutoCAD POC — credential hardening (added 2026-08-17)
# Line 151 has ".env" which does NOT cover ".env.middleware".
# These patterns are LAST in the file so they win (git: last match wins).
# ---------------------------------------------------------------
.env
.env.*
!.env.example
creds/
creds/**

# Working copies of CAD data (large binaries, sourced from ../../documents/)
data/
*.dwg
*.dxf
*.dxf.gz
*.excalidraw

# Build / runtime artifacts
.venv/
web/node_modules/
web/.next/
web/*.tsbuildinfo
web/out/
__pycache__/
*.pyc
.pytest_cache/

# NOTE: `docs/` is deliberately NOT ignored. It holds the decision log,
# the audit report and the briefs -- the project's memory. A blanket
# `docs/` rule (inherited from a Python template) had kept every one of
# them untracked, so 55 recorded decisions existed on one disk only.
# `docs/_build/` above still covers generated output.

# Git worktree untuk fan-out subagent (Gelombang 2 kampanye UPLIFT).
# Diletakkan DI DALAM repo, bukan di sebelahnya, dengan alasan konkret:
# daftar `additionalDirectories` sesi otonom hanya memuat `../../documents`,
# jadi worktree di `code/uplift-A` jatuh di luar direktori kerja yang
# diizinkan dan setiap tulis di sana memunculkan dialog izin.
.worktrees/

# Question-harness transcripts: one dated report per run. Evidence of a run,
# not source, and they accumulate fast.
scripts/qa_reports/
web/tsconfig.tsbuildinfo
