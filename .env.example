# ---------------------------------------------------------------------------
# ADK x AutoCAD POC — configuration template.
#
#     cp .env.example .env
#
# `.env` is gitignored; THIS file is not, so it must never contain a real
# value. Share this file when someone asks how to configure the project; never
# share `.env` itself, and never over WhatsApp, Teams or chat.
#
# Only TWO variables below have no default and must be filled in:
# MONGODB_URI and GOOGLE_API_KEY. Get both from GCP Secret Manager or the team
# vault. Everything else is a working default, safe to leave alone.
#
# `docker compose` reads this file directly and REFUSES TO START without it:
#     env file .../poc-adk-autocad/.env not found
# ---------------------------------------------------------------------------

# --- Ports (host side) -----------------------------------------------------
# Verified free on 2026-08-17; see docs/PORTS.md. Move the whole block if one
# of them is taken, so the numbers stay consecutive.
WEB_PORT=4310
CAD_API_PORT=4311
CAD_MCP_PORT=4312
# cad-agent (ADK api_server). docker-compose reads it as ${AGENT_PORT:-4314},
# so leaving it out still works -- it is listed because docs/PORTS.md tells you
# to move the whole block, and a block with a missing member is not a block.
AGENT_PORT=4314
# Only used by the `local-mongo` profile, which is off by default. The project
# runs against the shared cluster in MONGODB_URI and publishes no database port.
MONGO_PORT=4313

# --- MongoDB ---------------------------------------------------------------
# REQUIRED. Connection string for the shared cluster.
#
# NOTE: the database name is NOT configurable. It is pinned to
# "roshn-gpt-dev-main" in cad_api/app/mongo.py, and every collection this
# project creates is prefixed "autocad_". That is a safety guardrail, not a
# default: the database is shared with other teams. MONGODB_DB_NAME is read,
# logged as ignored, and then ignored.
#
# Bentuk normal (wifi biasa) — DNS harus bisa melayani query SRV:
#   mongodb+srv://<user>:<pass>@roshn-gpt-dev.jwupt.mongodb.net/?retryWrites=true&w=majority
#
# Fallback tanpa SRV. Dipakai kalau resolver DNS tidak mengembalikan record SRV
# — kasus umum pada tethering hotspot HP; gejalanya Compass/pymongo gagal
# connect padahal internet jalan. Host shard adalah A record biasa, jadi tetap
# resolve. `replicaSet` dan `authSource` WAJIB ditulis manual di sini: pada
# bentuk +srv keduanya datang dari TXT record cluster.
#   mongodb://<user>:<pass>@roshn-gpt-dev-shard-00-00.jwupt.mongodb.net:27017,\
#   roshn-gpt-dev-shard-00-01.jwupt.mongodb.net:27017,\
#   roshn-gpt-dev-shard-00-02.jwupt.mongodb.net:27017/\
#   ?ssl=true&replicaSet=atlas-iwfxnw-shard-0&authSource=admin&retryWrites=true&w=majority
#
# Nama host shard bisa berubah kalau Atlas me-resize/migrasi cluster, jadi
# bentuk +srv tetap yang utama; yang ini hanya untuk keadaan darurat.
MONGODB_URI=
MONGO_TIMEOUT_MS=8000

# --- Agent (Gemini API, not Vertex) ----------------------------------------
# REQUIRED. Gemini API key. Vertex is deliberately off: GOOGLE_API_KEY is what
# this project has access to.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
CAD_AGENT_MODEL=gemini-2.5-flash

# --- cad-api ---------------------------------------------------------------
CAD_DXF_DIR=/data/dxf
CAD_SVG_DIR=/data/svg
CAD_LOG_LEVEL=INFO
# Entities rendered into a single SVG before the render is truncated.
CAD_RENDER_MAX_ENTITIES=60000
# Rows returned by one list call.
CAD_MAX_ROWS=100
# Above this many matches, list endpoints return a breakdown instead of rows.
CAD_TOO_MANY_THRESHOLD=5000
CAD_CORS_ORIGINS=http://localhost:4310

# --- cad-mcp ---------------------------------------------------------------
# Seconds cad-mcp waits on a cad-api call before giving up. Raise it if a
# `measure` over a very large layer times out.
CAD_MCP_TIMEOUT=60

# --- web -------------------------------------------------------------------
# READ THIS BEFORE EDITING THE FOUR BELOW.
#
# The `web` service in docker-compose.yml has NO `env_file:` entry. It sets
# NEXT_PUBLIC_API_URL, CAD_API_INTERNAL_URL and AGENT_URL itself, in its
# `environment:` block. So changing them HERE does not affect the container --
# verified: CAD_AGENT_APP and AGENT_TIMEOUT_MS are simply unset inside the
# running web container and fall back to the defaults compiled into the code.
#
# They matter in one case only: running the frontend outside Docker with
# `npm run dev` (port 3000), where Next.js does read .env.
#
# To change the API port the browser talks to, set CAD_API_PORT above and
# rebuild: NEXT_PUBLIC_API_URL is baked into the bundle at image build time.

# Browser-side URL of cad-api. Must be reachable from the host, not from
# inside the compose network.
NEXT_PUBLIC_API_URL=http://localhost:4311
# Server-side URL, used by Next.js route handlers inside the network.
CAD_API_INTERNAL_URL=http://cad-api:8000
AGENT_URL=http://cad-agent:8000
# ADK app name, as returned by GET /list-apps on cad-agent.
CAD_AGENT_APP=cad_agent
# How long a route handler waits for the agent before reporting a timeout.
AGENT_TIMEOUT_MS=180000
